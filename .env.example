# ---------------------------------------------------------------------------
# RecallOps environment configuration
# Copy to `.env` and fill in values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Hindsight persistent memory -------------------------------------------
# Base URL of a running Hindsight API (docker compose up -d brings one up).
HINDSIGHT_BASE_URL=http://localhost:8888
# Optional bearer token. Leave empty for an unsecured local server.
HINDSIGHT_API_KEY=
# Memory bank that holds durable organizational learning.
HINDSIGHT_BANK_ID=recallops-org
# Per-request timeout (seconds) for Hindsight calls.
HINDSIGHT_TIMEOUT=6.0
# When "1"/"true", use the real Hindsight SDK. When "0"/"false", force the
# deterministic local memory store (useful for tests / offline demos).
HINDSIGHT_ENABLED=auto

# --- LLM -------------------------------------------------------------------
# Provider id. Options: "openai_compatible" (OpenAI, Groq, OpenRouter, vLLM,
# LM Studio, Ollama's /v1 endpoint, ...), "local_heuristic" (deterministic
# offline reasoning engine, no API key required).
LLM_PROVIDER=local_heuristic
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=45.0
LLM_TEMPERATURE=0.0

# --- Database --------------------------------------------------------------
DATABASE_URL=sqlite:///./recallops.db

# --- App -------------------------------------------------------------------
DEMO_MODE=true
SCENARIOS_DIR=./scenarios
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# --- ports (avoid the usual suspects) --------------------------------------
API_HOST=127.0.0.1
API_PORT=8765
WEB_PORT=4321
LOG_LEVEL=info
